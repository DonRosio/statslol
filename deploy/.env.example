# Settings of statslol in production: copy this file to /srv/statslol/.env on the server and
# fill it in there (sudo chmod 600 .env: only root may read it). Never commit the real one.
# deploy/compose.yaml reads it; each container only receives the variables it needs.

# Version of the images to run: "sha-" and the first 7 characters of a commit of main (the
# tag that .github/workflows/images.yml gives them), e.g. sha-1a2b3c4.
STATSLOL_VERSION=

# The Riot API key of the product (personal key): see the .env.example at the root.
RIOT_API_KEY=
# 2 for the personal key: its player IDs differ from the development key's.
RIOT_KEY_GENERATION=2

# Generate each password with: openssl rand -hex 32
# The PostgreSQL passwords are set when the database is created: changing them here later
# does not change them in the database.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=

# Optional: fatal, error, warn, info (default), debug, trace or silent.
# LOG_LEVEL=info
