# Caddy of the server: serves the mini-games site, statslol and Plume Lite (HTTPS certificates
# included). The mini-games blocks belong to that website; statslol's site is in
# statslol.caddy, Plume Lite's in plume-lite.caddy.
{
	# The admin API can change the whole configuration of Caddy. By default it listens on
	# localhost:2019, open to every program of the server; this socket, in Caddy's own
	# folder (drwxr-x--- caddy), is only open to root and to Caddy, which uses it for
	# `systemctl reload caddy`.
	admin unix//var/lib/caddy/admin.sock
}

# The blocks the sites share (security.caddy). The mini-games site sends its security headers itself
# (its application does): it only hides the Server header.
import /etc/caddy/security.caddy

# The mini-games site (its application sends its own security headers: it only hides the Server
# header). Its old names redirect to it; they used to be its address (www.donrgames.fr).
games.donr-corp.fr {
	import hide_server
	reverse_proxy 127.0.0.1:3000
}

www.donrgames.fr, donrgames.fr {
	import hide_server
	redir https://games.donr-corp.fr{uri}
}

import /etc/caddy/statslol.caddy

# Plume Lite (plume-lite.donr-corp.fr), another project on this server: its site block comes from
# its own repository, DonRosio/plume-lite (deploy/plume-lite.caddy, deploy/README.md).
# Installing this file without this line takes Plume Lite offline.
import /etc/caddy/plume-lite.caddy
