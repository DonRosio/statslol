# statslol, imported by /etc/caddy/Caddyfile. Its containers (deploy/compose.yaml) only
# listen on the server itself: the API on port 3100, the web app on port 3101.
statslol.donrgames.fr {
	# Only the friends listed in statslol-friends may open it: the browser asks a name and
	# a password. Managed with `sudo statslol-friends`, never by hand. Except /api/health,
	# which only answers "ok": an uptime monitor checks it from the Internet.
	@private not path /api/health
	basic_auth @private {
		import /etc/caddy/statslol-friends
	}

	# Security headers: those every site gets (security.caddy), the strict ones, and the policy
	# of what the pages may load (their own scripts, styles and requests, and the images of Data
	# Dragon, Riot's CDN; nothing inline, no plugin, never inside a frame). Set at once, so that
	# the 401 of basic_auth, all that strangers ever see, has them too.
	import security_base
	import security_strict
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

	encode zstd gzip

	# One JSON line per request in /var/log/caddy/statslol-access.log, which fail2ban reads to
	# block an address whose password is refused too often (deploy/server/etc/fail2ban/). Caddy
	# makes the file readable by itself only and writes no password (the Authorization header
	# is REDACTED); a few weeks at most are kept, in 1 MiB files.
	log {
		output file /var/log/caddy/statslol-access.log {
			roll_size 1MiB
			roll_keep 4
			roll_keep_for 336h
		}
		format json
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3100 {
			# The API sends security headers of its own (helmet): keep only the ones above.
			header_down -Strict-Transport-Security
			header_down -Content-Security-Policy
			header_down -X-Frame-Options
			header_down -X-Content-Type-Options
			header_down -Referrer-Policy
			header_down -Cross-Origin-Opener-Policy
			header_down -Cross-Origin-Resource-Policy
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3101
	}
}
