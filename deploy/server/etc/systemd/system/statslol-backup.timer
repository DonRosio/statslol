[Unit]
Description=Back up the database of statslol every night

[Timer]
# Before the automatic reboots, at 04:00 UTC (apt.conf.d/51unattended-upgrades-reboot).
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=10min
# Also at the next boot, if the server was off at that time.
Persistent=true

[Install]
WantedBy=timers.target
