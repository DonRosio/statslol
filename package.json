{
  "name": "statslol",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --no-bail dev",
    "build": "pnpm --recursive build",
    "db:generate": "pnpm --filter @statslol/api db:generate",
    "db:migrate": "pnpm --filter @statslol/api db:migrate",
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "vitest run --project=!db",
    "test:db": "vitest run --project=db",
    "test:e2e": "pnpm --filter @statslol/web test:e2e"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "catalog:",
    "vitest": "^5.0.3"
  }
}
