    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@redis/client": "^6.3.0",
    "@statslol/core": "workspace:*",
    "@statslol/riot-client": "workspace:*",
    "@statslol/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "msw": "catalog:",
    "pino-pretty": "^13.1.3"
  }
