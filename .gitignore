# --- Secrets: never commit -------------------------------------------------
# Real configuration lives in .env files; only the documented template is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build outputs ---------------------------------------------------------
dist/
build/
*.tsbuildinfo

# --- Tests -----------------------------------------------------------------
coverage/
# Playwright: results and recordings of the last run
test-results/
playwright-report/
blob-report/

# --- Logs ------------------------------------------------------------------
*.log

# --- Local tooling ---------------------------------------------------------
# Per-user Claude Code permissions (shared settings would go in .claude/settings.json).
.claude/settings.local.json

# --- OS / editors ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
