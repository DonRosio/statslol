# Template documenting every environment variable the app reads.
# It must never contain real values: copy it to .env (ignored by git) and fill that in.
#   cp .env.example .env && chmod 600 .env
# A variable is added here only when the code starts reading it.

# Riot Games API key: server-side only, never sent to the browser.
# Development keys expire every 24 hours; regenerate them at https://developer.riotgames.com
RIOT_API_KEY=
# Riot encrypts player IDs (PUUIDs) with a key specific to each application: increment this
# when RIOT_API_KEY becomes the key of another application (e.g. development key → personal
# key), so that the IDs stored for the previous one are fetched again. Optional, default 1.
# RIOT_KEY_GENERATION=1

# --- API server (optional: the commented values are the defaults) ----------
# Network interface to listen on: "localhost" only accepts connections from this machine.
# HOST=localhost
# PORT=3000
# Minimum log level: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
# Pause (milliseconds) between two calls to Riot while the games of a season are loaded in
# the background (Champions tab). The development and personal keys allow about 100 calls
# per 2 minutes, shared with the visitors: 2000 keeps 40% for them. Lower it with a
# production key.
# SEASON_SYNC_PACE_MS=2000
# Reverse proxies (IP addresses or ranges, comma-separated) allowed to give the address of
# the visitor in X-Forwarded-For; the limits per address count it. Only behind Caddy, in
# production (deploy/compose.yaml sets it). Unset: the address of the connection.
# TRUST_PROXY=

# --- PostgreSQL and Redis (compose.yaml) -----------------------------------
# Generate each password with: openssl rand -hex 32
# The PostgreSQL passwords are set when the database is created (first `docker compose up`):
# changing them here afterwards does not change them in the database.
# Superuser "postgres": creates the database, runs the migrations (pnpm db:migrate).
POSTGRES_PASSWORD=
# Role "statslol_app", used by the API (stored matches): reads and writes rows, cannot
# change the schema.
POSTGRES_APP_PASSWORD=
# Redis, the cache of the API. Without Redis the API still answers, from Riot.
REDIS_PASSWORD=
# Where PostgreSQL and Redis are (optional: the commented values are the defaults).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# REDIS_HOST=localhost
# REDIS_PORT=6379
